# Libredesk trial - environment variable NAMES and example values.
# This file contains NO secrets. Copy the names into Railway and supply real
# values there (Railway variables, or `railway variable set KEY --stdin`).
#
# Naming rule: LIBREDESK_ prefix, double underscore for a nested TOML key.
#   app.encryption_key        -> LIBREDESK_APP__ENCRYPTION_KEY
#   upload.fs.upload_path     -> LIBREDESK_UPLOAD__FS__UPLOAD_PATH

# --- Application -------------------------------------------------------------
# Exactly 32 characters. Generate with: openssl rand -hex 16
# Must be set before the first start and never changed afterwards.
LIBREDESK_APP__ENCRYPTION_KEY=<32 random characters>

# `app.root_url` is stored in the database and loaded at startup, so the value
# that actually takes effect is the one set in the UI under Settings -> General.
LIBREDESK_APP__ROOT_URL=https://<subdomain>.tarshli.com

# Optional: disable the upstream version check.
LIBREDESK_APP__CHECK_UPDATES=false

# --- PostgreSQL (dedicated instance; private network only) -------------------
LIBREDESK_DB__HOST=<railway postgres private host>
LIBREDESK_DB__PORT=5432
LIBREDESK_DB__USER=<db user>
LIBREDESK_DB__PASSWORD=<db password>
LIBREDESK_DB__DATABASE=<db name>
LIBREDESK_DB__SSL_MODE=disable

# --- Redis (dedicated instance) ---------------------------------------------
LIBREDESK_REDIS__ADDRESS=<redis host>:6379
# LIBREDESK_REDIS__PASSWORD=<redis password>

# --- Uploads (must point at the mounted Railway volume) ---------------------
LIBREDESK_UPLOAD__FS__UPLOAD_PATH=/libredesk/uploads

# --- Used only by the one-time `--install` invocation, then remove -----------
LIBREDESK_SYSTEM_USER_PASSWORD=<strong password for the System user>
